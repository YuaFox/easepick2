.theme-container
  &.no-sidebar
    .sidebar
      display none

@media (prefers-color-scheme: dark)
  body
    background-color #1a1a2e
    color #e0e0e0

  .theme-default-content
    h1, h2, h3, h4, h5, h6
      color #e0e0e0

  .sidebar
    background-color #16213e
    border-right-color #2a2a4a

  .navbar
    background-color #16213e
    border-bottom-color #2a2a4a

  .search-box input
    background-color #1a1a2e
    color #e0e0e0
    border-color #2a2a4a
